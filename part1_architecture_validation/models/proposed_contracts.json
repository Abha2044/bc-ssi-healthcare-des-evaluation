{
  "schema_version": "1.0",
  "purpose": "Proposed R7 rules for C4 to send decisions and restrictions to C6. Not a verified baseline implementation.",
  "assessment_status": "proposed_not_reviewed_or_tested",
  "contracts": [
    {
      "id": "CONTRACT-R7-I2",
      "requirement_id": "R7",
      "flow_id": "FLOW-R7",
      "interaction_id": "R7-I2",
      "provider": "C4",
      "consumer": "C6",
      "interface": "policy_decision_api",
      "direction": "response",
      "source_supported_responsibilities": {
        "evidence_refs": [
          "RequirementsAppendixB-refined(1).docx, Section A R7",
          "RequirementsAppendixB-refined(1).docx, Table C R7"
        ],
        "statements": [
          "C4 provides a decision and any restrictions.",
          "C6 applies the restrictions before data is released.",
          "C15 may help filter records."
        ],
        "boundary": "These are described roles; the exact message format and rules below are proposed."
      },
      "proposed_payload": {
        "type": "object",
        "required_fields": [
          "decision",
          "obligations"
        ],
        "additional_fields_allowed": false,
        "fields": {
          "decision": {
            "type": "string",
            "allowed_values": [
              "permit",
              "deny"
            ]
          },
          "obligations": {
            "type": "array",
            "item_variants": [
              {
                "action": "mask_fields",
                "required_fields": [
                  "action",
                  "fields"
                ],
                "fields": {
                  "type": "array_of_unique_nonempty_strings"
                },
                "meaning": "Remove named fields."
              },
              {
                "action": "filter_date_range",
                "required_fields": [
                  "action",
                  "field",
                  "from",
                  "to"
                ],
                "field": {
                  "type": "nonempty_string"
                },
                "from": {
                  "type": "ISO_8601_calendar_date"
                },
                "to": {
                  "type": "ISO_8601_calendar_date"
                },
                "meaning": "Keep dates within the inclusive range."
              }
            ]
          }
        },
        "example": {
          "decision": "permit",
          "obligations": [
            {
              "action": "mask_fields",
              "fields": [
                "address"
              ]
            },
            {
              "action": "filter_date_range",
              "field": "record_date",
              "from": "2026-09-10",
              "to": "2026-10-09"
            }
          ]
        }
      },
      "proposed_processing_rules": [
        "Deny access: release no data.",
        "Permit access: apply all listed restrictions.",
        "Filter by date first, then remove named fields.",
        "If a required restriction is invalid or cannot be applied, release no data.",
        "Check the full response before release; never release a partial result."
      ],
      "modeling_assumptions": [
        {
          "id": "A-R7-1",
          "detail": "This message format and its failure rules are proposed, not existing API evidence."
        },
        {
          "id": "A-R7-2",
          "detail": "Records are simple invented examples, not real FHIR data. Other security checks are outside this example."
        }
      ],
      "test_fixture": [
        {
          "id": "record-1",
          "record_date": "2026-09-01",
          "address": "Synthetic address A",
          "clinical_summary": "Older synthetic record"
        },
        {
          "id": "record-2",
          "record_date": "2026-09-20",
          "address": "Synthetic address B",
          "clinical_summary": "Recent synthetic record"
        }
      ],
      "planned_test_cases": [
        {
          "id": "R7-T1",
          "name": "Deny prevents disclosure",
          "policy_response": {
            "decision": "deny",
            "obligations": []
          },
          "expected": {
            "outcome": "denied",
            "released_records": []
          }
        },
        {
          "id": "R7-T4",
          "name": "Unsupported obligation blocks disclosure",
          "policy_response": {
            "decision": "permit",
            "obligations": [
              {
                "action": "unsupported_action"
              }
            ]
          },
          "expected": {
            "outcome": "enforcement_blocked",
            "released_records": []
          }
        },
        {
          "id": "R7-T5",
          "name": "Mask and date filter apply together",
          "policy_response": {
            "decision": "permit",
            "obligations": [
              {
                "action": "mask_fields",
                "fields": [
                  "address"
                ]
              },
              {
                "action": "filter_date_range",
                "field": "record_date",
                "from": "2026-09-10",
                "to": "2026-10-09"
              }
            ]
          },
          "expected": {
            "outcome": "permitted",
            "released_records": [
              {
                "id": "record-2",
                "record_date": "2026-09-20",
                "clinical_summary": "Recent synthetic record"
              }
            ]
          }
        }
      ],
      "assessment_boundaries": [
        "These examples do not prove that the real baseline works this way.",
        "Passing these examples does not prove that all of R7 is satisfied."
      ]
    }
  ]
}