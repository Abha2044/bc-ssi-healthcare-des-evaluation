{
  "schema_version": "1.0",
  "purpose": "Example rules for C4 decisions and C6 disclosure enforcement. Not baseline implementation evidence.",
  "assessment_status": "proposed",
  "contracts": [
    {
      "id": "CONTRACT-R7-I2",
      "requirement_id": "R7",
      "flow_id": "FLOW-R7",
      "interaction_id": "R7-I2",
      "provider": "C4",
      "consumer": "C6",
      "interface": "policy_decision_api",
      "direction": "response",
      "source_supported_responsibilities": {
        "evidence_refs": [
          "RequirementsAppendixB-refined(1).docx, Section A R7",
          "RequirementsAppendixB-refined(1).docx, Table C R7"
        ],
        "statements": [
          "C4 sends allow/deny and restrictions.",
          "C6 applies restrictions before release.",
          "C15 helps filter records."
        ],
        "boundary": "Only conceptual roles are documented; exact rules are proposed."
      },
      "proposed_payload": {
        "type": "object",
        "required_fields": [
          "decision",
          "obligations"
        ],
        "additional_fields_allowed": false,
        "fields": {
          "decision": {
            "type": "string",
            "allowed_values": [
              "permit",
              "deny"
            ]
          },
          "obligations": {
            "type": "array",
            "item_variants": [
              {
                "action": "mask_fields",
                "required_fields": [
                  "action",
                  "fields"
                ],
                "fields": {
                  "type": "array_of_unique_nonempty_strings"
                },
                "meaning": "Remove every named top-level field from every disclosed model record."
              },
              {
                "action": "filter_date_range",
                "required_fields": [
                  "action",
                  "field",
                  "from",
                  "to"
                ],
                "field": {
                  "type": "nonempty_string"
                },
                "from": {
                  "type": "ISO_8601_calendar_date"
                },
                "to": {
                  "type": "ISO_8601_calendar_date"
                },
                "meaning": "Return only records whose named date lies within the inclusive bounds."
              }
            ]
          }
        },
        "example": {
          "decision": "permit",
          "obligations": [
            {
              "action": "mask_fields",
              "fields": [
                "address"
              ]
            },
            {
              "action": "filter_date_range",
              "field": "record_date",
              "from": "2026-09-10",
              "to": "2026-10-09"
            }
          ]
        }
      },
      "proposed_processing_rules": [
        "Check the decision, obligations and dates before release.",
        "Deny returns no health records.",
        "Permit applies every listed restriction. An empty list means no extra transformation, not bypassing authorization.",
        "Unknown restrictions, invalid dates or missing required fields block all disclosure.",
        "Filter records by date first, then remove masked fields.",
        "A missing record date blocks a date-filtered request; masking an already absent field is harmless.",
        "Never return partly restricted results. Audit is assessed separately."
      ],
      "modeling_assumptions": [
        {
          "id": "A-R7-1",
          "detail": "This JSON is a proposed contract, not a real API."
        },
        {
          "id": "A-R7-2",
          "detail": "Records are flat synthetic data, not real FHIR resources."
        },
        {
          "id": "A-R7-3",
          "detail": "Date bounds are inclusive calendar dates; timestamps are not modeled."
        },
        {
          "id": "A-R7-4",
          "detail": "Invalid restrictions block release; this is a proposed rule."
        },
        {
          "id": "A-R7-5",
          "detail": "The right response is assumed to match the right request."
        }
      ],
      "test_fixture": [
        {
          "id": "record-1",
          "record_date": "2026-09-01",
          "address": "Synthetic address A",
          "clinical_summary": "Older synthetic record"
        },
        {
          "id": "record-2",
          "record_date": "2026-09-20",
          "address": "Synthetic address B",
          "clinical_summary": "Recent synthetic record"
        }
      ],
      "planned_test_cases": [
        {
          "id": "R7-T1",
          "name": "Deny prevents disclosure",
          "policy_response": {
            "decision": "deny",
            "obligations": []
          },
          "expected": {
            "outcome": "denied",
            "released_records": []
          }
        },
        {
          "id": "R7-T2",
          "name": "Mask removes prohibited field",
          "policy_response": {
            "decision": "permit",
            "obligations": [
              {
                "action": "mask_fields",
                "fields": [
                  "address"
                ]
              }
            ]
          },
          "expected": {
            "outcome": "permitted",
            "released_records": [
              {
                "id": "record-1",
                "record_date": "2026-09-01",
                "clinical_summary": "Older synthetic record"
              },
              {
                "id": "record-2",
                "record_date": "2026-09-20",
                "clinical_summary": "Recent synthetic record"
              }
            ]
          }
        },
        {
          "id": "R7-T3",
          "name": "Date filtering excludes older record",
          "policy_response": {
            "decision": "permit",
            "obligations": [
              {
                "action": "filter_date_range",
                "field": "record_date",
                "from": "2026-09-10",
                "to": "2026-10-09"
              }
            ]
          },
          "expected": {
            "outcome": "permitted",
            "released_records": [
              {
                "id": "record-2",
                "record_date": "2026-09-20",
                "address": "Synthetic address B",
                "clinical_summary": "Recent synthetic record"
              }
            ]
          }
        },
        {
          "id": "R7-T4",
          "name": "Unsupported obligation blocks disclosure",
          "policy_response": {
            "decision": "permit",
            "obligations": [
              {
                "action": "unsupported_action"
              }
            ]
          },
          "expected": {
            "outcome": "enforcement_blocked",
            "released_records": []
          }
        },
        {
          "id": "R7-T5",
          "name": "Mask and date filter apply together",
          "policy_response": {
            "decision": "permit",
            "obligations": [
              {
                "action": "mask_fields",
                "fields": [
                  "address"
                ]
              },
              {
                "action": "filter_date_range",
                "field": "record_date",
                "from": "2026-09-10",
                "to": "2026-10-09"
              }
            ]
          },
          "expected": {
            "outcome": "permitted",
            "released_records": [
              {
                "id": "record-2",
                "record_date": "2026-09-20",
                "clinical_summary": "Recent synthetic record"
              }
            ]
          }
        }
      ],
      "assessment_boundaries": [
        "These examples do not validate historical C4/C6 software.",
        "Passing examples does not establish complete R7 or FHIR correctness."
      ]
    }
  ]
}