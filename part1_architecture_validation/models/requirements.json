{
  "schema_version": "1.1",
  "model_purpose": "Solution-neutral requirement capabilities for architectural coverage validation.",
  "source_document": {
    "name": "Requirements Appendix B",
    "source_section": "Table C capability-goal column"
  },
  "derivation_policy": {
    "rule": "Required capabilities are derived only from the capability-goal text. Runtime-flow steps, component assignments, architectural findings, coverage classifications, and refinements are excluded.",
    "source_control_domains_are_metadata": true,
    "source_control_domains_are_not_component_matching_constraints": true,
    "review_status": "draft_requires_domain_review"
  },
  "capability_types": {
    "behaviour": "An operation or responsibility that can be provided by one or more components.",
    "architectural_constraint": "A condition that must be assessed across the architecture rather than assigned to one component.",
    "quality_outcome": "An intended quality effect that requires an explicit assessment criterion or supporting evidence."
  },
  "coverage_semantics": {
    "mandatory": "The capability must be covered.",
    "conditional": "The capability must be covered when its stated condition applies.",
    "at_least_one": "At least one listed alternative must be covered.",
    "applicable_alternatives": "At least one alternative must be supported, and every alternative used by the selected architecture or flow must be covered.",
    "unresolved_condition": "A conditional capability with unknown applicability must be reported as applicability_not_determined, not covered."
  },
